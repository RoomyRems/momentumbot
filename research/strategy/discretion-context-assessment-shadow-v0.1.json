        "requires_observed_fact": true,
        "requires_inference": true,
        "abstention_allowed": true
      },
      {
        "axis_id": "opportunity_obviousness_leadership_quality",
        "allowed_evidence_domains": [
          "scanner_market",
          "attention_leadership",
          "portfolio_attention"
        ],
        "values": [
          "dominant_persistent_leader",
          "emerging_leader",
