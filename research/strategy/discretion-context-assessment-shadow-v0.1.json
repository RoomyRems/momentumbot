  "artifact_type": "causal_shadow_context_assessment_protocol",
  "status": "preregistered_schema_only_no_runtime_artifact",
  "purpose": "Bind deterministic decision-time context and evidence-cited semantic shadows without ranking, selecting, sizing, or trading a candidate.",
  "runtime_strategy_effect": "none",
  "aggregate_score_frozen": false,
  "selection_threshold_frozen": false,
  "ai_order_authority": false,
  "ai_risk_authority": false,
  "policy_promotion_eligible": false,
  "frozen_parents": {
