      ],
      "causal_theme_fit_absent": [
        "theme_regime"
      ],
      "causal_no_news_momentum_acceptance_present": [
        "theme_regime"
      ],
      "dominant_persistent_leader": [
        "attention_leadership"
      ],
      "emerging_leader": [
        "attention_leadership"
      ],
