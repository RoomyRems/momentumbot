  "reproduction_sources": {
    "generate-exit-acquisition-synthetic.py": {
      "sha256": "c7ffdd2b5bb7277c52653af3a713a7373ac4e7f6a4aa34fb039cfc738caeab13",
      "source": "\"\"\"Reproduce provider-free retained acquisition evidence using the real SDK.\"\"\"\nfrom pathlib import Path\nimport json\nimport shutil\nimport sys\nfrom unittest.mock import patch\n\nroot = Path(sys.argv[1]).resolve()\nparents = Path(sys.argv[2]).resolve()\noutput = Path(sys.argv[3]).resolve()\nsys.path[:0] = [str(root), str(root/'src'), str(root/'scripts')]\nfrom tests.test_sealed_historical_management_exit_acquisition_v01 import Harness, REQUESTS, dbn_body\nfrom momentumbot.research import sealed_historical_management_exit_acquisition_v01 as a\nfrom verify_sealed_historical_management_exit_acquisition_registration_v01 import check\n\nverify_parents = a.verify_parents\noutput.mkdir()\nresults = {}\nfor label, options in (\n    ('complete_with_three_unavailable', {'empty': (0, 1, 10)}),\n    ('native_metadata_failure', {'malformed': dbn_body(REQUESTS[0], empty=True, delta=1)}),\n    ('metadata_http_failure', {'metadata_failure': True}),\n):\n    base = output/label\n    base.mkdir()\n    h = Harness(base, **options)\n    for name in a.PARENT_ARTIFACTS:\n        shutil.copyfile(parents/name, h.pre/name)\n    h.parents = verify_parents(h.pre, root)\n    with h.context(), patch.object(a, 'verify_parents', side_effect=verify_parents):\n        consumed = h.run('--consume')\n        acquired = h.run('--acquire')\n        primary = a.verify_capture(h.output, root)\n        independent = check(root, h.output, h.output)\n    result = {'synthetic_only': True, 'consume_exit_code': consumed,\n        'acquire_exit_code': acquired, 'simulated_http_calls': len(h.session.calls),\n        'real_provider_calls': 0, 'primary': primary, 'independent': independent,\n        'mocked_boundaries': ['provider HTTP session', 'execution identities',\n            'local environment version attestation', 'HTTP pacing', 'audit hook'],\n        'real_boundaries': ['both quote ZIPs and all members', 'SDK routing and decoding',\n            'native metadata and mapping validation', 'frozen normalization',\n            'bounded tape writing', 'journals, receipts, complete capture verification']}\n    (base/'verification.json').write_text(json.dumps(result, sort_keys=True, indent=2)+'\\n')\n    results[label] = result\n(output/'results.json').write_text(json.dumps(results, sort_keys=True, indent=2)+'\\n')\nprint(json.dumps({k: {'exit_code':v['acquire_exit_code'], 'capture':v['independent']['capture']} for k,v in results.items()}))\n"
    },
    "run-exit-acquisition-validation.py": {
      "sha256": "bbecacea7b586b41f9eb070fd5fde51ebd265f2eec80147e4e5b50fb0f9ee9a2",
      "source": "from pathlib import Path\nimport hashlib\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\n\nlabel, mode = sys.argv[1:3]\nroot = Path('/workspace/scratch/2d76267c92e1/momentumbot')\nout = Path('/workspace/scratch/b3ce0ef3e0fa')\npython = '/workspace/scratch/193af10e3424/quote-env/bin/python'\ncmd = [python]\nif mode == 'optimized': cmd.append('-O')\ncmd += ['-m', 'unittest']\nif mode == 'full': cmd += ['discover', '-s', 'tests', '-v']\nelse: cmd += ['tests.test_sealed_historical_management_exit_acquisition_v01', 'tests.test_sealed_historical_management_exit_quote_v01', 'tests.test_sealed_historical_execution_acquisition_v03', 'tests.test_sealed_historical_execution_acquisition_v02', 'tests.test_sealed_historical_record_order_v01', '-v']\nenv = dict(os.environ); env['PYTHONPATH'] = 'src:scripts'\nstart = time.perf_counter()\nr = subprocess.run(cmd, cwd=root, env=env, capture_output=True)\nraw = r.stdout + b'\\n' + r.stderr\nwith (out / (label + '.log')).open('xb') as f:\n    if f.write(raw) != len(raw): raise RuntimeError('short log write')\n    f.flush(); os.fsync(f.fileno())\nreport = {'command': cmd, 'exit_code': r.returncode, 'elapsed_seconds': round(time.perf_counter() - start, 3),\n    'log_sha256': hashlib.sha256(raw).hexdigest(), 'log_bytes': len(raw),\n    'summary': [s for s in raw.decode().splitlines() if s.startswith(('Ran ', 'OK', 'FAILED', 'ERROR:', 'FAIL:'))]}\nwith (out / (label + '.json')).open('x') as f: json.dump(report, f, indent=2)\nprint(json.dumps(report))\nraise SystemExit(r.returncode)\n"
    }
  },
